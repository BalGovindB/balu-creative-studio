# Copy to .env.local and fill in. With no keys set, every engine falls back to the
# offline "mock" providers so the whole pipeline still runs end to end.

# ---- Script / storyboard (Claude) ----
ANTHROPIC_API_KEY=
SCRIPT_PROVIDER=auto            # auto | anthropic | template
ANTHROPIC_MODEL=claude-opus-5

# ---- Image + video generation ----
IMAGE_PROVIDER=auto             # auto | replicate | mock
VIDEO_PROVIDER=auto             # auto | replicate | mock
REPLICATE_API_TOKEN=
REPLICATE_TEXT_TO_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_IMAGE_EDIT_MODEL=google/nano-banana
REPLICATE_VIDEO_MODEL=bytedance/seedance-1-lite

# ---- Access ----
# Set this in a deployment and the browser asks for a password before anything loads.
# Any username works; only the password is checked. Leave empty to disable (local dev).
APP_PASSWORD=

# ---- Media ----
# Optional absolute path to ffmpeg; defaults to the bundled ffmpeg-static binary.
FFMPEG_PATH=
# Optional default font (TTF/OTF) used when a brand kit has no font.
DEFAULT_FONT_PATH=
# Shrinks every render proportionally, for hosts with little memory.
# 1 = full size (1080x1920), 0.67 = 720p-class. Range 0.3-1.
RENDER_SCALE=
# Where uploads, brand kits and renders are stored.
STORAGE_DIR=./storage
